# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.

# HubSpot Private App token
# Settings → Integrations → Private Apps → your app → Auth tab
HUBSPOT_API_KEY=your_hubspot_pat_here

# HubSpot portal ID (find in URL: app.hubspot.com/contacts/XXXXXXXX)
HUBSPOT_PORTAL_ID=your_portal_id_here

# Slack Bot token (if using Slack integrations)
# api.slack.com/apps → your app → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-token-here

# ----------------------------------------------------------------
# Google APIs (GA4, Search Console, Google Ads)
# See docs/google-api-setup.md for the one-time setup runbook.
# ----------------------------------------------------------------

# Service account key (used by GA4 + Search Console). Two ways to provide it:
#
#   Local dev — a path to the key file. Keep the file outside the repo:
GOOGLE_SERVICE_ACCOUNT_JSON=/absolute/path/to/google-sa.json
#
#   Cloud / headless routine — the key's JSON CONTENT (raw or base64) set as an
#   environment secret, so no key file ever lands on disk or in git. If set, it
#   takes priority over the path above. Do NOT put a real value here in the repo
#   — set it in the cloud environment's secrets UI.
# GOOGLE_SERVICE_ACCOUNT_JSON_CONTENT=

# GA4 property ID (numeric, no `properties/` prefix).
# GA4 → Admin → Property Settings → Property ID
GA4_PROPERTY_ID=

# Search Console verified site URL — must match exactly, including trailing slash.
# e.g. https://{{COMPANY_DOMAIN}}/  or  sc-domain:{{COMPANY_DOMAIN}}
GSC_SITE_URL=https://www.example.com/

# Google Ads — OAuth refresh token flow (service accounts not supported for most accounts).
# See docs/google-api-setup.md for how to generate the refresh token once.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=

# ----------------------------------------------------------------
# Calendar + Gmail read-only (OAuth refresh token)
# ----------------------------------------------------------------
# Used by the HEADLESS chief-of-staff routine to pull Calendar/Gmail without the
# interactive claude.ai connector, which does not survive unattended runs.
# Generate the refresh token once with `python3 scripts/google_oauth_setup.py`
# (scopes: calendar.readonly + gmail.readonly). In the cloud routine, set these
# as environment secrets — never commit real values. See docs/google-api-setup.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ----------------------------------------------------------------
# Luma (events) — used by the in-repo Luma MCP server (scripts/luma_mcp.py)
# ----------------------------------------------------------------
# Calendar-scoped Luma Plus API key, sent as the x-luma-api-key header.
# Generate at luma.com/calendar/manage/api-keys. Local dev: set here in .env.
# Cloud / headless routine: set as an environment secret — never commit a real key.
LUMA_API_KEY=your_luma_calendar_api_key_here

# Write tier is OFF unless this is exactly "1". Leave unset for read-only — the
# default everywhere, including cloud routines. When set to 1, the three write
# tools (create_event, update_event, create_upload_url) register; each still
# hits an interactive permission prompt.
# LUMA_ENABLE_WRITES=1

# ----------------------------------------------------------------
# Added in the gtm-fleet migration
# ----------------------------------------------------------------

# Service-account JSON as base64 (cloud routines that cannot mount a file).
# Takes precedence over GOOGLE_SERVICE_ACCOUNT_JSON when set.
GOOGLE_SERVICE_ACCOUNT_JSON_CONTENT=

# Extra HubSpot keys read by scripts/hubspot/luma_scaffold.py
HUBSPOT_SERVICE_KEY=
HUBSPOT_SANDBOX_PORTAL_ID=

# Gates (off by default everywhere)
LUMA_ENABLE_WRITES=0            # 1 registers Luma write tools (still interactive-approved)
PERFORMANCE_MARKETER_EXECUTE=off              # off = shadow; live = apply greenlit auto_3a ad changes

# Fleet runtime — see scripts/fleet_paths.py, scripts/fleet_git.py, scripts/tick.py
FLEET_ROOT=                     # where state/ lives; blank = this repo (workspace mode)
FLEET_PROFILE=                  # profile name; blank = fleet.yaml:profile or "base"
FLEET_BRANCH=                   # branch agents must be on; blank = whatever is checked out
FLEET_REMOTE=                   # git remote to sync/push; blank = local-commit mode (single machine)
FLEET_CLAUDE_BIN=               # path to the claude CLI if not on PATH
FLEET_PERMISSION_MODE=acceptEdits
FLEET_MAX_TURNS=80
FLEET_MAX_BUDGET_USD=5
FLEET_TICK_TIMEOUT_S=1800
DEMO_MODE=0                     # 1 = fixture-backed connectors (Phase 2)
